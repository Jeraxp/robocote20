# Spike Robocote 2.0 — variáveis de ambiente
# Copie para .env e preencha quando a Segfy provisionar as credenciais novas da Nova Jornada

PORT=3030
NODE_ENV=development

# Banco Robocote 2.0 — multi-tenant, usuários, sessões e integrações.
# Sem DATABASE_URL, o spike usa memória local e perde sessões ao reiniciar.
DATABASE_URL=
DATABASE_SSL=0
DATABASE_POOL_MAX=10

# Auth alpha — temporário até login real.
# Headers internos aceitos em dev: x-robocote-role, x-robocote-tenant-id, x-robocote-user-*
# Se ROBOCOTE_PANEL_TOKEN estiver preenchido, /api/painel/* e /api/admin/* exigem x-robocote-panel-token.
ROBOCOTE_PANEL_TOKEN=
ROBOCOTE_DEV_ROLE=superadmin
ROBOCOTE_DEV_TENANT_ID=
ROBOCOTE_DEV_USER_ID=taskdun-superadmin
ROBOCOTE_DEV_USER_NAME=Taskdun Superadmin
ROBOCOTE_DEV_USER_EMAIL=admin@taskdun.com.br

# Segfy — Nova Jornada (canônico do Robocote 2.0)
SEGFY_BASE_URL=https://api.automation.segfy.com
SEGFY_SOCKET_URL=https://socket-io.segfy.com
SEGFY_CLIENT_ID=
SEGFY_CLIENT_SECRET=

# Corretora-piloto RPI — token específico pra Nova Jornada oficial
RPI_CORRETORA_TOKEN=

# IA — Taskdun API (compatível com chat/completions)
TASKDUN_AI_BASE_URL=
TASKDUN_AI_CHAT_PATH=/v1/chat/completions
TASKDUN_AI_API_KEY=

# Papéis de modelo — Robocote 2.0
# - Extractor (mini): roteador de intenção e extração de slots em JSON. Tarefa estruturada, barata.
# - Dialog (5.3-chat-latest): voz do Robocote em turnos rotineiros (captura, confirmações curtas).
# - Analyst (5.4): voz do Robocote em modo Consulta, perfil/cobertura, objeções e mensagens complexas.
ROBOCOTE_EXTRACTOR_MODEL=gpt-5.4-mini
ROBOCOTE_DIALOG_MODEL=gpt-5.3-chat-latest
ROBOCOTE_ANALYST_MODEL=gpt-5.4

# Conhecimento/RAG — base curada de seguradoras, coberturas e fluxos
ROBOCOTE_EMBEDDING_MODEL=text-embedding-3-small
ROBOCOTE_VECTOR_STORE_ID=
ROBOCOTE_RAG_MAX_RESULTS=5

# Canal WhatsApp — seleção de transporte
# 'cloudapi' (oficial Meta, padrão do produto) | 'evolution' (legado em extinção)
# Sem valor: auto — cloudapi se configurado, senão evolution
WHATSAPP_CHANNEL=

# Canal WhatsApp via Cloud API oficial (Meta — Taskdun Tech Provider)
# Webhook a cadastrar no painel Meta: GET/POST {backend}/webhooks/cloudapi/webhook
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_CLOUD_PHONE_NUMBER_ID=
WHATSAPP_CLOUD_VERIFY_TOKEN=
WHATSAPP_CLOUD_APP_SECRET=
WHATSAPP_CLOUD_GRAPH_VERSION=v23.0

# Canal WhatsApp via Evolution API (self-hosted) — LEGADO
# Webhook inbound: POST {backend}/webhooks/evolution/incoming
EVOLUTION_BASE_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=
EVOLUTION_WEBHOOK_SECRET=

# Identidade do tenant pra sessões WhatsApp (corretora-piloto)
ROBOCOTE_TENANT_ID=rpi
ROBOCOTE_TENANT_SLUG=rpi

# ── Espelho do legado (Fase 1 da unificação) ─────────────────────────────────
# Receptor POST /api/ingest/leads — FECHADO por padrão: sem secret, endpoint recusa (503)
ROBOCOTE_INGEST_SECRET=
# Allowlist opcional de tenants aceitos na ingestão (csv). Ex.: robotestes,renova
ROBOCOTE_INGEST_TENANTS=
# TTL dos leads no store em dias (default 7; subir p/ leads espelhados não evaporarem)
ROBOCOTE_LEAD_TTL_DAYS=

# Observador do legado (src/tools/legacy-mirror-poller.ts — processo separado, leitura pura)
LEGACY_MIRROR_DB_HOST=
LEGACY_MIRROR_DB_PORT=3306
LEGACY_MIRROR_DB_USER=
LEGACY_MIRROR_DB_PASSWORD=
LEGACY_MIRROR_DB_NAME=robocote
# Fuso do MySQL legado (produção confirmada UTC em 27/08/2026)
LEGACY_MIRROR_DB_TZ=Z
LEGACY_MIRROR_INGEST_URL=
# JSON cliente_id legado -> tenantId painel. Ex.: {"999":"robotestes"}
LEGACY_MIRROR_TENANT_MAP=
LEGACY_MIRROR_INTERVAL_MS=60000
LEGACY_MIRROR_STATE_FILE=./legacy-mirror-state.json
ROBOCOTE_TENANT_NAME=Corretora Piloto RPI

# URL pública do Robocote 2.0 (usada no link do Quote Room enviado pelo WhatsApp).
# Em dev com Cloudflare Tunnel: https://seu-tunnel.trycloudflare.com
# Em produção: https://app.robocote.com.br
ROBOCOTE_QUOTE_BASE_URL=
